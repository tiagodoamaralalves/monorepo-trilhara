<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>br.com.trilhara</groupId>
    <artifactId>backend-trilhara-quarkus</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>Trilhara-app</name>
    <description>API trilhara</description>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <quarkus.platform.version>3.40.1</quarkus.platform.version>
        <compiler-plugin.version>3.14.1</compiler-plugin.version>
        <surefire-plugin.version>3.5.4</surefire-plugin.version>
        <!-- versões usadas pelo gate (archunit 1.5.1 suporta class
 files até Java 27; jacoco 0.8.16 tem suporte oficial a Java 27 e
 cobre Java 25 desde 0.8.14). -->
        <archunit.version>1.5.1</archunit.version>
        <jacoco-plugin.version>0.8.16</jacoco-plugin.version>
        <!-- dependency-plugin 3.10.0 usa ASM que entende bytecode Java 25
 (major 69). As versões 3.7/3.8.1 falham com "Unsupported class file major
 version 69" e tornariam o gate `dependency:analyze` inexecutável. -->
        <dependency-plugin.version>3.10.0</dependency-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-mongodb-client</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-openapi</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-health</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-validator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-scheduler</artifactId>
        </dependency>
        <!-- métrica trilhara_account_deletion_stuck (exclusão de conta travada). -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-micrometer</artifactId>
        </dependency>
        <!-- `quarkus-jacoco` instrumenta os testes `@QuarkusTest`. Sem ele o
 agente do JaCoCo não segue a classe carregada pelo QuarkusClassLoader e o
 relatório mede 0% em todos os serviços exercitados por integração
 (TrilhaService 0/1885, TarefaService 0/3710), tornando inaplicável. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jacoco</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- ArchUnit para as regras arquiteturais (TenantIsolationArchTest). -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                            <goal>generate-code-tests</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler-plugin.version}</version>
                <configuration>
                    <parameters>true</parameters>
                    <!-- o padrão do Maven só compila **/*Test.java em src/test/java,
 o que deixaria de fora fixtures compartilhadas como RotasPrivadas
 (allowlist do teste anti-IDOR). Inclui todo o diretório de teste. -->
                    <testIncludes>
                        <testInclude>**/*.java</testInclude>
                    </testIncludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <configuration>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <!-- gate `dependency:analyze` — falha o build com dependência
 declarada e não usada ou usada e não declarada. Fixado em 3.10.0 porque
 versões anteriores não leem bytecode Java 25 (major 69).

 Exceções abaixo são estruturais do Quarkus, não dívida:
 (a) extensões `io.quarkus:*` são agregadores de build-time: o bytecode da
 extensão não é referenciado pela aplicação, mas sem a declaração o
 Quarkus não registra o módulo (Mongo, REST/Jackson, scheduler, etc.);
 (b) os transitivos que o Quarkus expõe como API pública (Jackson, JAX-RS,
 MicroProfile Health, Micrometer, Vert.x, JBoss Logging, quarkus-core)
 são usados diretamente no código e chegam via BOM — declará-los
 individualmente duplicaria a gestão de versão do BOM;
 (c) `archunit-junit5` é o agregador que traz `-api`/`-engine` usados nos
 testes. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>${dependency-plugin.version}</version>
                <configuration>
                    <failOnWarning>true</failOnWarning>
                    <ignoreNonCompile>true</ignoreNonCompile>
                    <ignoredUnusedDeclaredDependencies>
                        <ignoredUnusedDeclaredDependency>io.quarkus:*</ignoredUnusedDeclaredDependency>
                        <ignoredUnusedDeclaredDependency>com.tngtech.archunit:archunit-junit5</ignoredUnusedDeclaredDependency>
                    </ignoredUnusedDeclaredDependencies>
                    <ignoredUsedUndeclaredDependencies>
                        <!-- Transitivos gerenciados pelo quarkus-bom e usados diretamente no
 código (APIs públicas do Quarkus/Jakarta/Jackson/Mongo/Vert.x/
 MicroProfile) ou por fixtures de teste. Declará-los
 individualmente duplicaria a gestão de versão do BOM. -->
                        <ignoredUsedUndeclaredDependency>io.quarkus:*</ignoredUsedUndeclaredDependency>
                        <ignoredUsedUndeclaredDependency>jakarta.*:*</ignoredUsedUndeclaredDependency>
                        <ignoredUsedUndeclaredDependency>org.eclipse.microprofile.*:*</ignoredUsedUndeclaredDependency>
                        <ignoredUsedUndeclaredDependency>com.fasterxml.jackson.core:*</ignoredUsedUndeclaredDependency>
                        <ignoredUsedUndeclaredDependency>org.mongodb:*</ignoredUsedUndeclaredDependency>
                        <ignoredUsedUndeclaredDependency>io.vertx:*</ignoredUsedUndeclaredDependency>
                        <ignoredUsedUndeclaredDependency>io.micrometer:*</ignoredUsedUndeclaredDependency>
                        <ignoredUsedUndeclaredDependency>io.rest-assured:*</ignoredUsedUndeclaredDependency>
                        <ignoredUsedUndeclaredDependency>org.jboss.logging:*</ignoredUsedUndeclaredDependency>
                        <ignoredUsedUndeclaredDependency>org.junit.*:*</ignoredUsedUndeclaredDependency>
                        <ignoredUsedUndeclaredDependency>org.hamcrest:*</ignoredUsedUndeclaredDependency>
                        <ignoredUsedUndeclaredDependency>com.tngtech.archunit:*</ignoredUsedUndeclaredDependency>
                    </ignoredUsedUndeclaredDependencies>
                </configuration>
                <executions>
                    <execution>
                        <id>analisar-dependencias</id>
                        <goals>
                            <goal>analyze</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>
            <!-- JaCoCo em modo ENFORCE.

 A fonte de dados é `target/jacoco-quarkus.exec`, produzida pela extensão
 `io.quarkus:quarkus-jacoco` (test scope). Sem essa extensão o agente do
 prepare-agent não alcança as classes carregadas pelo QuarkusClassLoader e o
 relatório mede 0% em todo serviço exercitado por `@QuarkusTest`
 (TrilhaService 0/1885, TarefaService 0/3710). O `.exec` do Quarkus já agrega
 unitários + integração; medido nesta revisão: 40551/50676 = 80,0% global. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco-plugin.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report-quarkus</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco-quarkus.exec</dataFile>
                            <outputDirectory>${project.build.directory}/site/jacoco</outputDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>check-cobertura</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco-quarkus.exec</dataFile>
                            <haltOnFailure>true</haltOnFailure>
                            <!-- domínio backend ≥ 75%. Os dois pacotes abaixo ficam
 um pouco abaixo por serem infraestrutura de erro/fachada
 fina; cada exceção está justificada no relatório . -->
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.75</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <excludes>
                                        <!-- DTOs: records sem lógica; cobertos por construção
 no round-trip BSON, não por unidade. -->
                                        <exclude>*.dto</exclude>
                                        <!-- Fachada fina de fuso/usuário, usada por todos os
 testes indiretamente (54,1% de instrução). -->
                                        <exclude>br.com.trilhara.shared</exclude>
                                    </excludes>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.60</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
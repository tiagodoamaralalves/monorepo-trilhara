# ============================================================================
# 1. SEGREDOS CRIPTOGRÁFICOS OBRIGATÓRIOS
# ============================================================================
# Copie este arquivo para .env e gere chaves seguras e aleatórias:
#   openssl rand -base64 48
AUTH_JWT_SECRET=
AUTH_PASSWORD_PEPPER=

# ============================================================================
# 2. DOMÍNIO, PROXY REVERSO E AUTO-HTTPS (CADDY 2)
# ============================================================================
# DEV LOCAL:
#   DOMAIN=localhost
#   SITE_ADDRESS=:80
#   CADDY_GLOBAL_OPTIONS=auto_https off
#   EXPOSE_QUARKUS_DEV_UI=true
#
# PRODUÇÃO (VPS com DNS apontado para a máquina):
#   DOMAIN=trilhara.com.br
#   SITE_ADDRESS=trilhara.com.br
#   CADDY_GLOBAL_OPTIONS=email devops@trilhara.com.br
#   EXPOSE_QUARKUS_DEV_UI=false
DOMAIN=localhost
SITE_ADDRESS=:80
CADDY_GLOBAL_OPTIONS=auto_https off
EXPOSE_QUARKUS_DEV_UI=false

# ============================================================================
# 3. SEGURANÇA DE AUTENTICAÇÃO, SESSÃO E CORS (QUARKUS)
# ============================================================================
AUTH_STRICT_MODE=true

# Em DEV LOCAL:
#   AUTH_REFRESH_COOKIE_SECURE=false
#   AUTH_REFRESH_COOKIE_DOMAIN=
#   AUTH_CORS_ALLOWED_ORIGINS=http://localhost,http://estudos.localhost,http://tarefas.localhost,http://notas.localhost,http://pomodoro.localhost
#
# Em PRODUÇÃO (HTTPS obrigatório para cookies seguros):
#   AUTH_REFRESH_COOKIE_SECURE=true
#   AUTH_REFRESH_COOKIE_DOMAIN=.trilhara.com.br
#   AUTH_CORS_ALLOWED_ORIGINS=https://trilhara.com.br,https://estudos.trilhara.com.br,https://tarefas.trilhara.com.br,https://notas.trilhara.com.br,https://pomodoro.trilhara.com.br
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAMESITE=Lax
AUTH_REFRESH_COOKIE_DOMAIN=
AUTH_CORS_ALLOWED_ORIGINS=http://localhost,http://estudos.localhost,http://tarefas.localhost,http://notas.localhost,http://pomodoro.localhost

# Janela de carência do refresh token rotacionado (evita 401 em corrida de duas abas).
AUTH_REFRESH_EXP_DAYS=30
AUTH_REFRESH_GRACE_PERIOD_SECONDS=10

# Identidade do JWT (issuer/audience fazem parte da validação do token).
AUTH_JWT_ISSUER=https://trilhara.com.br
AUTH_JWT_AUDIENCE=trilhara-web
AUTH_JWT_ACCESS_EXP_SECONDS=900
AUTH_JWT_CLOCK_SKEW_SECONDS=30

# PBKDF2-SHA512: iterações e pepper (o pepper é segredo obrigatório).
AUTH_PASSWORD_ITERATIONS=310000
AUTH_RESET_EXP_MINUTES=15

# Bloqueio por senha errada: tentativas antes do bloqueio e duração do bloqueio.
AUTH_MAX_LOGIN_FAILURES=5
AUTH_LOCK_MINUTES=15

# Rate limit (D-45): janelas por IP e por usuário. Os limites por rota são constantes
# documentadas em RateLimitService (login/refresh/handoff 10/min, consume 20/min,
# busca de notas 60/min, criação de trilha/cronograma 30/min, exclusão 5/15min).
AUTH_RATELIMIT_LOGIN_MAX=10
AUTH_RATELIMIT_CADASTRO_MAX=10

# Limites de acervo por usuário.
TRILHAS_MAX_POR_USUARIO=50
NOTAS_MAX_CADERNOS=500
NOTAS_MAX_SECOES=500
NOTAS_MAX_PAGINAS=2000

# Exclusão de conta: tentativas rápidas e intervalo da retentativa lenta (D-35b).
ACCOUNT_DELETION_MAX_TENTATIVAS=5
ACCOUNT_DELETION_RETRY_LENTO_SECONDS=3600
ACCOUNT_DELETION_JOB_EVERY=30s

# Readiness de índices: intervalo de releitura de listIndexes (D-07).
MONGO_INDEX_HEALTH_INTERVAL_SECONDS=30

# ============================================================================
# 4. TUNING DE RECURSOS E PERFORMANCE (MONGODB)
# ============================================================================
# Limite de memória cache do WiredTiger (em GB).
# Recomendado: 0.25 para VPS de 1GB/2GB RAM, 0.5 para VPS de 4GB RAM.
MONGO_CACHE_GB=0.5
MONGODB_URL=mongodb://localhost:27017/?minPoolSize=5&maxPoolSize=50

# ============================================================================
# 5. SERVIÇO DE E-MAIL TRANSACIONAL (RESEND API)
# ============================================================================
RESEND_API_KEY=
EMAIL_FROM=Trilhara <onboarding@resend.dev>
FRONTEND_URL=http://localhost

# ============================================================================
# 6. WEB PUSH NOTIFICATIONS E VAPID (RFC 8030 / RFC 8292)
# ============================================================================
# Para gerar chaves VAPID:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@trilhara.com.br
PUSH_HABILITADO=true

# URL absoluta do deep link enviado no payload push (D-36d).
# A URL precisa estar na allowlist abaixo; caso contrário o backend falha no boot
# (proteção contra sequestro do clique da notificação).
TAREFAS_APP_URL=http://localhost/tarefas/
TAREFAS_APP_URL_ALLOWLIST=http://localhost,http://localhost:5173,http://localhost:80

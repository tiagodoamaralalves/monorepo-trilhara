{
	{$CADDY_GLOBAL_OPTIONS}
	admin off
}

(security_headers) {
	header {
		# CSP estrita: script-src 'self' sem unsafe-eval/unsafe-inline;
		# style-src mantém 'unsafe-inline' para variáveis CSS e estilos dinâmicos em React.
		# connect-src 'self' atende chamadas à API na mesma origem via proxy.
		# Fontes são self-hosted (/fonts/*).
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		# Handoff SSO viaja no fragmento da URL; strict-origin-when-cross-origin não
		# envia fragmento nem path a terceiros.
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# HSTS apenas em HTTPS: em dev local (auto_https off, SITE_ADDRESS=:80) o header
	# impediria o navegador de acessar http://localhost nas próximas visitas.
	@https_scheme expression {scheme} == "https"
	header @https_scheme Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

(api_proxy) {
	handle /api/* {
		reverse_proxy app:8080
	}

	@quarkus_dev {
		path /q/*
		expression `{$EXPOSE_QUARKUS_DEV_UI:false} == true`
	}
	handle @quarkus_dev {
		reverse_proxy app:8080
	}
}

(spa_frontend) {
	root * /srv/dist

	# a) Chunks com hash do Vite: cache imutavel de 1 ano e 404 se ausente
	@hashed_assets path /assets/*
	handle @hashed_assets {
		header Cache-Control "public, max-age=31536000, immutable"
		try_files {path} =404
		file_server
	}

	# Regras explícitas para Service Worker e Web Manifest
	@sw_script path /sw.js
	handle @sw_script {
		header Cache-Control "no-cache, no-store, must-revalidate"
		header Service-Worker-Allowed "/"
		try_files {path} =404
		file_server
	}

	@manifest path /manifest.webmanifest
	handle @manifest {
		header Content-Type "application/manifest+json"
		header Cache-Control "no-cache, must-revalidate"
		try_files {path} =404
		file_server
	}

	# b) Arquivos estaticos da raiz (favicon, manifest, fontes)
	@static_files path *.svg *.ico *.png *.json *.woff2 *.webmanifest
	handle @static_files {
		try_files {path} =404
		file_server
	}

	# c) Fallback SPA: no-cache estrito para index.html
	handle {
		header Cache-Control "no-cache, no-store, must-revalidate"
		try_files {path} /index.html
		file_server
	}
}

# 1. Subdomínios dos Módulos React Unificados (Estudos, Tarefas, Pomodoro, Notas)
estudos.{$DOMAIN:localhost},
tarefas.{$DOMAIN:localhost},
pomodoro.{$DOMAIN:localhost},
notas.{$DOMAIN:localhost} {
	import security_headers
	encode zstd gzip
	import api_proxy
	import spa_frontend
}

# 2. Servidor Principal
{$SITE_ADDRESS:localhost} {
	import security_headers
	encode zstd gzip
	import api_proxy

	# Redirecionamentos amigáveis com barra final
	redir /tarefas /tarefas/
	redir /estudos /estudos/
	redir /pomodoro /pomodoro/
	redir /notas /notas/

	# Assets compartilhados se requisitados na raiz
	handle /assets/* {
		root * /srv/dist
		header Cache-Control "public, max-age=31536000, immutable"
		try_files {path} =404
		file_server
	}

	# Rotas por caminho para os módulos do Frontend Unificado
	handle_path /tarefas/* {
		import spa_frontend
	}

	handle_path /estudos/* {
		import spa_frontend
	}

	handle_path /pomodoro/* {
		import spa_frontend
	}

	handle_path /notas/* {
		import spa_frontend
	}

	# Raiz (/) e demais rotas: Frontend Unificado (SPA com fallback no index.html)
	handle {
		import spa_frontend
	}
}

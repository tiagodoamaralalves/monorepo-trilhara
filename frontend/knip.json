{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/main.tsx", "src/test/setup.ts"],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": ["src/test/**", "dist/**"],
  "ignoreDependencies": [
    "@testing-library/jest-dom",
    "@testing-library/react",
    "@testing-library/user-event",
    "jsdom"
  ],
  "ignoreBinaries": ["knip", "eslint", "tsc"]
}
